{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Dashboard and compact widget windows: events and drag only. No fs, shell, http or updater.",
  "windows": ["main", "widget"],
  "permissions": ["core:event:default", "core:window:allow-start-dragging", "core:window:allow-minimize",
    "core:window:allow-toggle-maximize", "core:window:allow-close"]
}
