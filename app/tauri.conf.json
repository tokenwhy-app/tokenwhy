{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tokenwhy",
  "identifier": "dev.tokenwhy.app",
  "build": {
    "frontendDist": "ui-dist",
    "beforeBuildCommand": { "script": "npm run build", "cwd": "web" }
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  }
}
